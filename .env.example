# Get your bot token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Flask secret key — change this to a random string
SECRET_KEY=change-me-to-something-random

# Stock check interval in seconds (when product is out of stock)
CHECK_INTERVAL=10

# Cooldown in seconds after an in-stock alert before re-checking
ALERT_COOLDOWN=300

# Default pincode to seed on first run
DEFAULT_PINCODE=110086

